          "expr": "(sum(rate(ads_api_requests_total{job=\"report-api\",code=~\"5..\"}[5m])) or vector(0)) / sum(rate(ads_api_requests_total{job=\"report-api\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ]
    },
